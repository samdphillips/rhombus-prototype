#lang rhombus/static/and_meta

import:
  lib("racket/base.rkt") only #{make-immutable-hashalw}
  lib("json/main.rkt") ! #{for-extension} as rkt_json:
    rename #{read-json*} as read
    rename #{write-json*} as write

export:
  JSON
  write
  read

  to_string
  from_string

def known_json = WeakMutableMap.by(===)()

fun is_json(v):
  match v
  | _ :: (Int && Exact) || (Real && Inexact && Rational): #true
  | _ :: String: #true
  | _ :: Boolean: #true
  | #'null: #true
  | vs :: List:
      cond
      | vs in known_json: #true
      | (for all (v: vs): is_json(v)):
          known_json[vs] := #true
          #true
      | ~else: #false
  | m :: Map:
      cond
      | m in known_json: #true
      | (for all (values(k, v): m):
           k is_a String && is_json(v)):
          known_json[m] := #true
          #true
      | ~else: #false
  | _: #false


annot.macro 'JSON': 'satisfying(is_json)'


fun write(v :: JSON,
          out :: Port.Output):
  rkt_json.write(#'#{json.write},
                 v,
                 out,
                 ~encode: #'control,
                 ~indent: #false,
                 ~null: #'null,
                 #{#:object-rep?}: (_ is_a Map),
                 #{#:object-rep->hash}: values,
                 #{#:list-rep?}: (_ is_a List),
                 #{#:list-rep->list}: fun (vs): PairList(&vs),
                 #{#:key-rep?}: (_ is_a String),
                 #{#:key-rep->string}: values,
                 #{#:string-rep?}: (_ is_a String),
                 #{#:string-rep->string}: values)


fun to_string(v :: JSON) :: String:
  Closeable.let out = Port.Output.open_string()
  write(v, out)
  out.get_string()


fun read(in :: Port.Input) :: JSON:
  rkt_json.read(#'#{json.read},
                in,
                ~null: #'null,
                #{#:replace-malformed-surrogate?}: #false,
                #{#:make-object}: base.#{make-immutable-hashalw},
                #{#:make-list}: PairList.to_list,
                #{#:make-key}: String.snapshot,
                #{#:make-string}: String.snapshot)


fun from_string(s :: ReadableString) :: JSON:
  Closeable.let in = Port.Input.open_string(s)
  read(in)
